PORT=3000

# 상위 compose.yaml 의 postgres (pgvector 이미지), initdb/01-init.sh 가 만든 rag DB/role
DATABASE_URL=postgresql://rag:password@localhost:5434/rag

# vllm-mlx 서버 (make run, OpenAI 호환 API)
VLLM_BASE_URL=http://localhost:8100/v1
VLLM_API_KEY=not-needed
VLLM_MODEL=mlx-community/Qwen3-8B-4bit

EMBEDDING_MODEL=mlx-community/bge-m3-mlx-fp16
EMBEDDING_DIMENSIONS=1024

# 리랭커 (vllm-mlx --rerank-model)
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 벡터 검색 후보 수
RAG_TOP_K=5
# 리랭크 후 LLM 에 전달할 청크 수 (0 이면 리랭크 생략, TOP_K 그대로 전달)
RAG_RERANK_TOP_N=3
RAG_MIN_SIMILARITY=0.35

NODE_ENV=development
